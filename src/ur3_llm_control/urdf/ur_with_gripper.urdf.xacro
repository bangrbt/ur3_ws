<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <!-- Name parameter -->
  <xacro:arg name="name" default="ur"/>

  <!-- Include the default UR robot definition -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- ======================================================================= -->
  <!-- INDUSTRIAL PRECISION PARALLEL GRIPPER (TAY GẮP CÔNG NGHIỆP CAO CẤP)     -->
  <!-- Thiết kế kim loại phay xước đen, đệm silicone cam bám dính ma sát cực cao -->
  <!-- ======================================================================= -->

  <!-- 1. Đế chuyển tiếp mặt bích (Gripper Mounting Flange) -->
  <link name="gripper_flange_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.010"/>
      </geometry>
      <material name="flange_silver">
        <color rgba="0.75 0.78 0.82 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.010"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_flange_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 2. Thân chính Gripper (Body Housing - Nhôm Anode Đen phay xước) -->
  <link name="gripper_base_link">
    <visual>
      <!-- Khối thân chính dạng vát công nghiệp -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.056 0.092 0.040"/>
      </geometry>
      <material name="housing_black">
        <color rgba="0.12 0.13 0.15 1.0"/>
      </material>
    </visual>
    <!-- Rãnh trượt dẫn hướng ngón tay mạ chrome -->
    <visual>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.088 0.006"/>
      </geometry>
      <material name="rail_chrome">
        <color rgba="0.88 0.90 0.94 1.0"/>
      </material>
    </visual>
    <!-- Logo viền cam công nghiệp -->
    <visual>
      <origin xyz="0.029 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.040 0.012"/>
      </geometry>
      <material name="industrial_orange">
        <color rgba="1.0 0.45 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.056 0.092 0.040"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="gripper_flange_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- 3. Ngón kẹp bên trái (Left Gripper Finger - Active Prismatic Joint) -->
  <link name="gripper_left_finger">
    <!-- Càng kẹp hợp kim nhôm đen -->
    <visual>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.012 0.044"/>
      </geometry>
      <material name="finger_metal">
        <color rgba="0.22 0.24 0.28 1.0"/>
      </material>
    </visual>
    <!-- Đệm kẹp Silicone màu cam có độ bám ma sát cao -->
    <visual>
      <origin xyz="0 -0.005 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.003 0.038"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <!-- Mặt tiếp xúc va chạm ma sát cao -->
    <collision name="left_finger_pad_collision">
      <origin xyz="0 -0.005 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.006 0.040"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Khớp trượt trái: trượt theo trục Y (0.018m: kẹp chặt khối 4cm, 0.042m: mở rộng 8.4cm) -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.020 0.046" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.005" upper="0.028" effort="250.0" velocity="0.3"/>
  </joint>

  <!-- 4. Ngón kẹp bên phải (Right Gripper Finger - Active Prismatic Joint) -->
  <link name="gripper_right_finger">
    <!-- Càng kẹp hợp kim nhôm đen -->
    <visual>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.012 0.044"/>
      </geometry>
      <material name="finger_metal">
        <color rgba="0.22 0.24 0.28 1.0"/>
      </material>
    </visual>
    <!-- Đệm kẹp Silicone màu cam có độ bám ma sát cao -->
    <visual>
      <origin xyz="0 0.005 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.003 0.038"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <!-- Mặt tiếp xúc va chạm ma sát cao -->
    <collision name="right_finger_pad_collision">
      <origin xyz="0 0.005 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.006 0.040"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Khớp trượt phải: trượt đối xứng theo trục Y -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.020 0.046" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.028" upper="0.005" effort="250.0" velocity="0.3"/>
  </joint>

  <!-- 5. Điểm kẹp trung tâm (Tool Center Point - TCP) -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================================= -->
  <!-- GAZEBO SURFACE FRICTION: MA SÁT ĐỆM SILICONE VỪA PHẢI, TRÁNH TÍCH LỰC KHI NHẢ         -->
  <!-- ======================================================================= -->
  <gazebo reference="gripper_left_finger">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>2.5</mu>
            <mu2>2.5</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <kd>100.0</kd>
            <min_depth>0.0002</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
    <sensor name="left_finger_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <!-- sdformat them prefix/suffix nay khi chuyen URDF collision co ten. -->
        <collision>gripper_left_finger_fixed_joint_lump__left_finger_pad_collision_collision</collision>
        <!-- Gazebo Fortress doc topic o BEN TRONG contact. Dat ben ngoai lam
             sdformat sinh __default_topic__ va ROS bridge khong nhan du lieu. -->
        <topic>/gripper/left_contacts</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="gripper_right_finger">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>2.5</mu>
            <mu2>2.5</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>100000.0</kp>
            <kd>100.0</kd>
            <min_depth>0.0002</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
    <sensor name="right_finger_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <collision>gripper_right_finger_fixed_joint_lump__right_finger_pad_collision_collision</collision>
        <topic>/gripper/right_contacts</topic>
      </contact>
    </sensor>
  </gazebo>

  <!-- ======================================================================= -->
  <!-- GAZEBO JOINT POSITION CONTROLLER: ĐIỀU KHIỂN ĐỘ MỞ/ĐÓNG NGÓN TAY        -->
  <!-- ======================================================================= -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_left_joint</joint_name>
      <topic>/gripper/left_cmd</topic>
      <p_gain>80.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>8.0</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_right_joint</joint_name>
      <topic>/gripper/right_cmd</topic>
      <p_gain>80.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>8.0</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
  </gazebo>
</robot>
