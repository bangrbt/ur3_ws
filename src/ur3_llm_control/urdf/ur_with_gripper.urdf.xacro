<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <!-- Name parameter -->
  <xacro:arg name="name" default="ur"/>

  <!-- Include the default UR robot definition -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- Bàn tay kẹp cơ khí (2-Finger Parallel Gripper) gắn trực tiếp vào tool0 -->
  <!-- 1. Đế kẹp (Gripper Base) -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.18 0.18 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 2. Ngon kep trai (Left Finger - Active Prismatic Joint) -->
  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.05"/>
      </geometry>
      <material name="gripper_silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.01" upper="0.025" effort="100.0" velocity="0.2"/>
  </joint>

  <!-- 3. Ngon kep phai (Right Finger - Active Prismatic Joint) -->
  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.05"/>
      </geometry>
      <material name="gripper_silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.025" upper="0.01" effort="100.0" velocity="0.2"/>
  </joint>

  <!-- 4. Diem tac dong kep trung tam (Tool Center Point - TCP) -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- GAZEBO PLUGINS: DIEU KHIEN KHOP KEP & CO CHE DONG/MO VAT THE -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_left_joint</joint_name>
      <topic>/gripper/left_cmd</topic>
      <p_gain>200.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.5</d_gain>
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>
    </plugin>
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_right_joint</joint_name>
      <topic>/gripper/right_cmd</topic>
      <p_gain>200.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.5</d_gain>
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>
    </plugin>

    <!-- DetachableJoint cho 5 vat the -->
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link>
      <child_model>red_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/gripper/detach_red</detach_topic>
      <attach_topic>/gripper/attach_red</attach_topic>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link>
      <child_model>yellow_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/gripper/detach_yellow</detach_topic>
      <attach_topic>/gripper/attach_yellow</attach_topic>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link>
      <child_model>blue_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/gripper/detach_blue</detach_topic>
      <attach_topic>/gripper/attach_blue</attach_topic>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link>
      <child_model>green_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/gripper/detach_green</detach_topic>
      <attach_topic>/gripper/attach_green</attach_topic>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link>
      <child_model>purple_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/gripper/detach_purple</detach_topic>
      <attach_topic>/gripper/attach_purple</attach_topic>
    </plugin>
  </gazebo>
</robot>
