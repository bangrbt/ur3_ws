<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <!-- 1 kHz physics keeps grasp release stable for the 4 cm cubes. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- Giao dien va Goc nhin Camera mac dinh Gazebo huong ve ban thao tac -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.05 -0.85 0.65 0 0.45 2.45</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Anh sang mat troi -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.85</direction>
    </light>

    <!-- Mat san phong thi nghiem (Ground Floor tai Z = -0.64m) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.64 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.75 1</ambient>
            <diffuse>0.72 0.72 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ban thao tac Robot (Industrial Workbench hien dai) -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <!-- Mat ban (Tabletop) day 4cm, mat tren nam tai Z = 0.0m -->
        <collision name="top_collision">
          <pose>0.26 0.0 -0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.70 0.90 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0.26 0.0 -0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.70 0.90 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.85 1.0</ambient> <!-- Xam bac cong nghiep sang trong, de quan sat -->
            <diffuse>0.82 0.82 0.85 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>

        <!-- Khung vien kim loai xung quanh mat ban -->
        <visual name="top_border_visual">
          <pose>0.26 0.0 -0.038 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.92 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1.0</ambient>
            <diffuse>0.25 0.25 0.28 1.0</diffuse>
          </material>
        </visual>

        <!-- Chan ban 1 -->
        <visual name="leg1_visual">
          <pose>0.55 0.40 -0.34 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <!-- Chan ban 2 -->
        <visual name="leg2_visual">
          <pose>0.55 -0.40 -0.34 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <!-- Chan ban 3 -->
        <visual name="leg3_visual">
          <pose>-0.03 0.40 -0.34 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <!-- Chan ban 4 -->
        <visual name="leg4_visual">
          <pose>-0.03 -0.40 -0.34 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

