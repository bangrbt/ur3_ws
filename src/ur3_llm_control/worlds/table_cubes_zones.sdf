<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Anh sang mat troi -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mat dat -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ban thao tac (Work Table) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.35 0.0 -0.20 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.65 0.85 0.40</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.65 0.85 0.40</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung A (Zone A - Mau xanh lam) -->
    <model name="zone_a_pad">
      <static>true</static>
      <pose>0.40 -0.12 0.001 0 0 0</pose>
      <link name="zone_a_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 0.8</ambient>
            <diffuse>0.1 0.3 0.9 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung B (Zone B - Mau vang) -->
    <model name="zone_b_pad">
      <static>true</static>
      <pose>0.40 0.00 0.001 0 0 0</pose>
      <link name="zone_b_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.1 0.8</ambient>
            <diffuse>0.95 0.85 0.1 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung C (Zone C - Mau do) -->
    <model name="zone_c_pad">
      <static>true</static>
      <pose>0.40 0.12 0.001 0 0 0</pose>
      <link name="zone_c_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 0.8</ambient>
            <diffuse>0.9 0.1 0.1 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung Dem (Zone Temp - Mau xam) -->
    <model name="zone_temp_pad">
      <static>true</static>
      <pose>0.22 0.20 0.001 0 0 0</pose>
      <link name="zone_temp_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 0.8</ambient>
            <diffuse>0.6 0.6 0.6 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Khoi hop Do (red_cube) -->
    <model name="red_cube">
      <pose>0.30 -0.12 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000013</ixx>
            <iyy>0.000013</iyy>
            <izz>0.000013</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1.0</ambient>
            <diffuse>0.9 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Khoi hop Vang (yellow_cube) -->
    <model name="yellow_cube">
      <pose>0.30 0.00 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000013</ixx>
            <iyy>0.000013</iyy>
            <izz>0.000013</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.1 1.0</ambient>
            <diffuse>0.95 0.85 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Khoi hop Xanh lam (blue_cube) -->
    <model name="blue_cube">
      <pose>0.30 0.12 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000013</ixx>
            <iyy>0.000013</iyy>
            <izz>0.000013</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 1.0</ambient>
            <diffuse>0.1 0.3 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
